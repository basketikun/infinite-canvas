# 仅用于 docker-compose.cloud-sync.yml。复制为 server/.env.cloud 后替换每一个示例值，
# 并使用 docker compose --env-file server/.env.cloud；不需要覆盖本地 SQLite 的 server/.env。
CONTROL_PLANE_ENV_FILE=./server/.env.cloud
PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-production
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRE_HOURS=168
STORAGE_DRIVER=postgres
DATABASE_DSN=postgres://infinite_canvas:change-this-db-password@postgres:5432/infinite_canvas?sslmode=disable
PUBLIC_BASE_URL=http://localhost:8080
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001

POSTGRES_DB=infinite_canvas
POSTGRES_USER=infinite_canvas
POSTGRES_PASSWORD=change-this-db-password

MINIO_ROOT_USER=change-this-minio-user
MINIO_ROOT_PASSWORD=change-this-minio-password
SYNC_S3_ENDPOINT=http://minio:9000
SYNC_S3_ACCESS_KEY=change-this-minio-user
SYNC_S3_SECRET_KEY=change-this-minio-password
SYNC_S3_BUCKET=infinite-canvas-sync
