PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-production
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRE_HOURS=168
STORAGE_DRIVER=sqlite
DATABASE_DSN=/app/data/infinite-canvas.db
PUBLIC_BASE_URL=http://localhost:8080
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001
# 云同步启用时使用 MinIO/S3；生产环境须使用 PostgreSQL，以下凭据不得暴露给浏览器。
SYNC_S3_ENDPOINT=http://localhost:9000
SYNC_S3_ACCESS_KEY=change-this-minio-access-key
SYNC_S3_SECRET_KEY=change-this-minio-secret-key
SYNC_S3_BUCKET=infinite-canvas-sync
