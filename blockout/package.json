{
  "name": "blockout",
  "version": "5.1.1",
  "description": "Desktop previs tool for AI-native filmmaking — stage scenes, choreograph camera & character blocking with marks, export motion-reference packages for AI video generators.",
  "main": "out/main/index.js",
  "author": "Sam Wasserman",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "node ./node_modules/electron-vite/bin/electron-vite.js dev",
    "web:dev": "vite --config vite.web.config.ts",
    "web:build": "vite build --config vite.web.config.ts && npm run web:sync",
    "web:sync": "node scripts/sync-web-workbench.mjs",
    "start": "node ./node_modules/electron-vite/bin/electron-vite.js preview",
    "build": "node ./node_modules/electron-vite/bin/electron-vite.js build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npm run build && playwright test tests/e2e/smoke.spec.ts",
    "e2e": "npm run build && playwright test",
    "icons:win": "node scripts/generate-win-icon.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:builder-config": "node scripts/validate-builder-config.mjs",
    "verify:release-assets": "node scripts/audit-ffmpeg-redistribution.mjs",
    "prepare:ffmpeg:win": "node scripts/prepare-windows-ffmpeg.mjs",
    "prepare:ffmpeg:mac": "node scripts/prepare-macos-ffmpeg.mjs",
    "sbom": "node scripts/generate-sboms.mjs",
    "fetch:ffmpeg-source": "node scripts/fetch-ffmpeg-source.mjs",
    "package": "npm run package:mac",
    "package:mac": "node scripts/package-macos.mjs",
    "package:win": "npm run prepare:ffmpeg:win && npm run verify:release-assets && npm run build && electron-builder --win nsis --x64 --config electron-builder.yml --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@mkkellogg/gaussian-splats-3d": "^0.4.7",
    "three": "^0.170.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "@cyclonedx/cyclonedx-npm": "6.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0-beta.1",
    "eslint": "^9.39.2",
    "extract-zip": "2.0.1",
    "png-to-ico": "3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
