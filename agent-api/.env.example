SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-server-only-secret-key
AGENT_API_ORIGINS=http://localhost:3000
PI_PROVIDER=openai
PI_MODEL=gpt-5.6
PI_API_KEY=your-platform-model-key
PI_AGENT_DIR=/var/lib/research-canvas/pi
PORT=4100

# Codex 托管运行时（AGENT_RUNTIME=codex 时才需要；默认仍是 pi）
