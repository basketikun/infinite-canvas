{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Infinite Canvas",
    "version": "0.19.0",
    "identifier": "cloud.aiengine.infinitecanvas",
    "build": {
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Infinite Canvas",
                "width": 1440,
                "height": 900,
                "minWidth": 1024,
                "minHeight": 680,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.ico"
        ],
        "externalBin": ["binaries/node"],
        "resources": {
            "resources/canvas-agent/": "canvas-agent/"
        },
        "createUpdaterArtifacts": false,
        "windows": {
            "nsis": {
                "installMode": "currentUser",
                "displayLanguageSelector": true
            }
        }
    },
    "plugins": {
        "updater": {
            "endpoints": ["https://downloads.infinite.aiengine.cloud/latest.json"],
            "pubkey": "",
            "windows": {
                "installMode": "passive"
            }
        }
    }
}
